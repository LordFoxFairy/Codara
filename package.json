{
  "name": "Codara",
  "version": "1.0.0",
  "type": "module",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "dependencies": {
    "@langchain/anthropic": "^1.3.21",
    "@langchain/core": "^1.1.29",
    "@langchain/openai": "^1.2.11",
    "@modelcontextprotocol/sdk": "^1.27.1",
    "@tauri-apps/api": "^2",
    "clsx": "^2.1.1",
    "diff": "^8.0.3",
    "langchain": "^1.2.28",
    "lodash": "^4.17.23",
    "lucide-react": "^0.577.0",
    "react-dom": "^19.2.4",
    "tailwind-merge": "^3.5.0",
    "yaml": "^2.8.2",
    "zod": "^4.3.6",
    "zod-validation-error": "^4.0.2"
  },
  "devDependencies": {
    "@eslint/js": "9",
    "@tailwindcss/vite": "^4.2.1",
    "@tauri-apps/cli": "^2",
    "@types/bun": "^1.3.10",
    "@types/diff": "^8.0.0",
    "@types/node": "^25.3.3",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "eslint": "9",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "globals": "^17.3.0",
    "ink": "^6.8.0",
    "ink-testing-library": "^4.0.0",
    "prettier": "^3.8.1",
    "react": "^19.2.4",
    "tailwindcss": "^4.2.1",
    "tsc-alias": "^1.8.16",
    "typescript": "^5.5.3",
    "typescript-eslint": "^8.56.1",
    "vite": "^8.0.0"
  },
  "description": "",
  "private": true,
  "scripts": {
    "dev": "bun --watch src/cli/main.tsx",
    "cli": "bun --watch src/cli/main.tsx",
    "dev:once": "bun src/cli/main.tsx",
    "dev:server": "bun --watch src/server/index.ts",
    "dev:vite": "vite --config src/desktop/vite.config.ts",
    "desktop": "bun --watch src/server/index.ts & vite --config src/desktop/vite.config.ts --open",
    "desktop:tauri": "cargo tauri dev --config src-tauri/tauri.conf.json",
    "build": "rm -rf dist && tsc -p tsconfig.json && tsc-alias -p tsconfig.json --resolve-full-paths --resolve-full-extension .js",
    "build:desktop": "vite build --config src/desktop/vite.config.ts && cargo tauri build --config src-tauri/tauri.conf.json",
    "check": "bun run check:fast && bun test",
    "check:cases": "bun run check:fast && bun run test:cases",
    "check:fast": "bun run lint && bun run typecheck",
    "lint": "eslint src/ tests/",
    "lint:cli": "eslint src/cli/",
    "lint:fix": "eslint src/ tests/ --fix",
    "lint:cli:fix": "eslint src/cli/ --fix",
    "test": "bun test",
    "test:cases": "bun test tests/cases/",
    "typecheck": "tsc -p tsconfig.typecheck.json",
    "format": "prettier --write src/"
  }
}
