{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "jsx": "react-jsx",
    "moduleResolution": "Bundler",
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "skipLibCheck": true,
    "declaration": true,
    "declarationMap": true,
    "outDir": "dist",
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"],
      "@cli/*": ["src/cli/*"],
      "@codara/*": ["src/codara/*"],
      "@core/*": ["src/core/*"],
      "@tools": ["src/tools/index.ts"],
      "@tools/*": ["src/tools/*"],
      "@commands": ["src/commands/index.ts"],
      "@commands/*": ["src/commands/*"],
      "@skills": ["src/skills/index.ts"],
      "@skills/*": ["src/skills/*"],
      "@tasks": ["src/tasks/index.ts"],
      "@tasks/*": ["src/tasks/*"],
      "@memory": ["src/memory/index.ts"],
      "@memory/*": ["src/memory/*"],
      "@mcp": ["src/mcp/index.ts"],
      "@mcp/*": ["src/mcp/*"],
      "@models": ["src/models/index.ts"],
      "@models/*": ["src/models/*"],
      "@channels": ["src/channels/index.ts"],
      "@channels/*": ["src/channels/*"],
      "@hooks": ["src/hooks/index.ts"],
      "@hooks/*": ["src/hooks/*"],
      "@events": ["src/events/index.ts"],
      "@events/*": ["src/events/*"],
      "@cost": ["src/cost/index.ts"],
      "@cost/*": ["src/cost/*"],
      "@state/*": ["src/state/*"],
      "@context/*": ["src/context/*"],
      "@config/*": ["src/config/*"],
      "@shared/*": ["src/shared/*"],
      "@gateway/*": ["src/gateway/*"]
    }
  },
  "include": ["src"]
}
